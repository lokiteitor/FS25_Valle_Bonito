<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="sawdustWalls" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">

  <Files>
    <File fileId="4" filename="$data/shaders/buildingShader.xml" />
    <File fileId="1" filename="sawdustWalls_diffuse.png" />
    <File fileId="5" filename="sawdustWalls_mask.png" />
    <File fileId="2" filename="sawdustWalls_normal.png" />
    <File fileId="3" filename="sawdustWalls_specular.png" />
  </Files>

  <Materials>
    <Material name="lambert1" materialId="1" diffuseColor="0.5 0.5 0.5 1">
    </Material>
    <Material name="sawdustWalls_mat" materialId="2" customShaderId="4">
      <Custommap name="mMaskMap" fileId="5"/>
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="sawdustWalls.i3d.shapes">
  </Shapes>

  <Scene>
    <Shape name="sawdustWalls" shapeId="1" static="true" collisionFilterGroup="0x3e" collisionFilterMask="0xfffffbff" castsShadows="true" receiveShadows="true" nonRenderable="true" materialIds="1" nodeId="1">
      <Shape name="vis" shapeId="2" castsShadows="true" receiveShadows="true" materialIds="2" clipDistance="300" nodeId="2"/>
    </Shape>
  </Scene>

  <UserAttributes>
  </UserAttributes>
</i3D>
