<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="waterTowerTall" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">

  <Files>
    <File fileId="4" filename="$data/shaders/buildingShader.xml" />
    <File fileId="1" filename="waterTowers_diffuse.png" />
    <File fileId="5" filename="waterTowers_mask.png" />
    <File fileId="2" filename="waterTowers_normal.png" />
    <File fileId="3" filename="waterTowers_specular.png" />
  </Files>

  <Materials>
    <Material name="lambert1" materialId="1" diffuseColor="0.5 0.5 0.5 1">
    </Material>
    <Material name="waterTowers_mat" materialId="2" customShaderId="4">
      <Custommap name="mMaskMap" fileId="5"/>
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="waterTowerTall.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="waterTowerTall" lodDistance="0 120" collision="false" density="0" nodeId="1">
      <Shape name="LOD0" shapeId="1" static="true" collisionFilterGroup="0x3e" collisionFilterMask="0xfffffbff" castsShadows="true" receiveShadows="true" nonRenderable="true" materialIds="1" nodeId="2">
        <Shape name="visual" shapeId="2" castsShadows="true" receiveShadows="true" materialIds="2" clipDistance="700" nodeId="3"/>
      </Shape>
      <Shape name="LOD1" shapeId="3" castsShadows="true" receiveShadows="true" materialIds="2" clipDistance="800" nodeId="4"/>
      <Shape name="occluderMesh" shapeId="4" castsShadows="true" receiveShadows="true" nonRenderable="true" occluder="true" materialIds="1" nodeId="5"/>
    </TransformGroup>
  </Scene>

  <UserAttributes>
  </UserAttributes>
</i3D>
