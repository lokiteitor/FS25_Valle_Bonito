<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="forestWatchtower" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">

  <Files>
    <File fileId="12" filename="$data/maps/textures/shared/default_specular.png" />
    <File fileId="11" filename="$data/maps/textures/shared/mapDirt_diffuse.png" />
    <File fileId="13" filename="$data/maps/textures/shared/mapMoss_diffuse.png" />
    <File fileId="19" filename="$data/maps/textures/shared/props/icicles_diffuse.png" />
    <File fileId="20" filename="$data/maps/textures/shared/props/icicles_normal.png" />
    <File fileId="21" filename="$data/maps/textures/shared/props/icicles_specular.png" />
    <File fileId="14" filename="$data/maps/textures/shared/snow_diffuse.png" />
    <File fileId="15" filename="$data/maps/textures/shared/snow_normal.png" />
    <File fileId="16" filename="$data/maps/textures/shared/snow_specular.png" />
    <File fileId="10" filename="$data/shaders/buildingShader.xml" />
    <File fileId="17" filename="$data/shaders/snowHeapShader.xml" />
    <File fileId="1" filename="$data/shared/assets/assetLibraryDecals_diffuse.png" />
    <File fileId="2" filename="$data/shared/assets/assetLibraryDecals_normal.png" />
    <File fileId="3" filename="$data/shared/assets/assetLibraryDecals_vmask.png" />
    <File fileId="5" filename="$data/shared/default_normal.png" />
    <File fileId="18" filename="$data/shared/sparkles_normal.png" />
    <File fileId="4" filename="$data/shared/window02_diffuse.png" />
    <File fileId="6" filename="$data/shared/window02_specular.png" />
    <File fileId="7" filename="forestWatchtower_diffuse.png" />
    <File fileId="8" filename="forestWatchtower_normal.png" />
    <File fileId="9" filename="forestWatchtower_specular.png" />
  </Files>

  <Materials>
    <Material name="lambert1" materialId="6" diffuseColor="0.5 0.5 0.5 1">
    </Material>
    <Material name="assetLibraryDecals_mat" materialId="2">
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
    <Material name="window02_mat" materialId="3" alphaBlending="true">
      <Texture fileId="4"/>
      <Normalmap fileId="5"/>
      <Glossmap fileId="6"/>
    </Material>
    <Material name="forestWatchtower_mat" materialId="1" customShaderId="10">
      <CustomParameter name="dirtMossMix" value="1.0 1.0"/>
      <CustomParameter name="dirtMossSmoothness" value="0.12 0.12"/>
      <Custommap name="mDirtDiffuse" fileId="11"/>
      <Custommap name="mMaskMap" fileId="12"/>
      <Custommap name="mMossDiffuse" fileId="13"/>
      <Texture fileId="7"/>
      <Normalmap fileId="8"/>
      <Glossmap fileId="9"/>
    </Material>
    <Material name="snow_mat" materialId="4" customShaderId="17">
      <Custommap name="mSparklesNormal" fileId="18"/>
      <Texture fileId="14"/>
      <Normalmap fileId="15" bumpDepth="0.5"/>
      <Glossmap fileId="16"/>
    </Material>
    <Material name="icicles_mat" materialId="5" alphaBlending="true" customShaderId="17" customShaderVariation="icicle">
      <Texture fileId="19"/>
      <Normalmap fileId="20"/>
      <Glossmap fileId="21"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="forestWatchtower.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="forestWatchtower_lod" lodDistance="0 100" static="true" collisionFilterGroup="0x3e" collisionFilterMask="0xfffffbff" nodeId="1">
      <TransformGroup name="LOD0" nodeId="2">
        <Shape name="forestWatchtower" shapeId="1" castsShadows="true" receiveShadows="true" materialIds="1" clipDistance="300" nodeId="3"/>
        <Shape name="screwsDecals" shapeId="2" castsShadows="false" receiveShadows="true" decalLayer="1" materialIds="2" clipDistance="60" nodeId="4"/>
        <Shape name="glass" shapeId="3" castsShadows="false" receiveShadows="true" materialIds="3" clipDistance="300" nodeId="5"/>
        <TransformGroup name="seasons" nodeId="6">
          <TransformGroup name="winter" nodeId="7">
            <Shape name="snow" shapeId="4" castsShadows="true" receiveShadows="true" materialIds="4" clipDistance="150" nodeId="8" weatherRequiredMask="0x400"/>
            <Shape name="icicles" shapeId="5" castsShadows="true" receiveShadows="true" materialIds="5" clipDistance="75" nodeId="9" weatherRequiredMask="0x400"/>
          </TransformGroup>
        </TransformGroup>
        <Shape name="collision" shapeId="6" static="true" density="0" collisionFilterGroup="0x3e" collisionFilterMask="0xfffffbff" castsShadows="true" receiveShadows="true" nonRenderable="true" materialIds="6" nodeId="10"/>
      </TransformGroup>
      <TransformGroup name="LOD1" nodeId="11">
        <Shape name="forestWatchtower_LOD" shapeId="7" castsShadows="true" receiveShadows="true" materialIds="1" clipDistance="600" nodeId="12"/>
      </TransformGroup>
    </TransformGroup>
  </Scene>

  <UserAttributes>
  </UserAttributes>
</i3D>
