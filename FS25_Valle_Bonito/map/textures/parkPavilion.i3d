    <File fileId="9" filename="$data/maps/textures/shared/pierBuildingGutters_normal.png" />
    <File fileId="10" filename="pierBuildingGutters_specular.png" />
  </Files>

  <Materials>
    <Material name="lambert1" materialId="3" diffuseColor="0.5 0.5 0.5 1">
    </Material>
    <Material name="parkPavilion_mat" materialId="1" customShaderId="4" customShaderVariation="customParallax">
      <Custommap name="mDirtDiffuse" fileId="5" />
      <Custommap name="mMaskMap" fileId="6" />
      <Custommap name="mParallaxMap" fileId="7" />
      <Texture fileId="1" />
      <Normalmap fileId="2" />
      <Glossmap fileId="3" />
    </Material>
    <Material name="pierBuildingGutters_mat" materialId="2">
      <Texture fileId="8" />
      <Normalmap fileId="9" />
      <Glossmap fileId="10" />
    </Material>
    <Material name="autumnLeafs_mat" materialId="6">
      <Texture fileId="11" />
      <Normalmap fileId="12" />
      <Glossmap fileId="13" />
    </Material>
    <Material name="snow_mat" materialId="5" customShaderId="17">
      <Custommap name="mSparklesNormal" fileId="18" />
      <Texture fileId="14" />
      <Normalmap fileId="15" bumpDepth="0.5" />
      <Glossmap fileId="16" />
    </Material>
    <Material name="icicles_mat" materialId="4" alphaBlending="true" customShaderId="17" customShaderVariation="icicle">
      <Texture fileId="19" />
      <Normalmap fileId="20" />
      <Glossmap fileId="21" />
    </Material>
  </Materials>


  <Shapes externalShapesFile="parkPavilion.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="parkPavilion_lod" lockedgroup="true" lodDistance="0 120" collision="false" density="0" nodeId="1">
      <Shape name="LOD0" shapeId="1" castsShadows="true" receiveShadows="true" materialIds="1" clipDistance="300" nodeId="2">
        <Shape name="gutters" shapeId="2" static="true" collisionFilterGroup="0x3e" collisionFilterMask="0xfffffbff" castsShadows="true" receiveShadows="true" materialIds="2" clipDistance="300" nodeId="3" />
        <Shape name="col" shapeId="3" static="true" density="0" collisionFilterGroup="0x3e" collisionFilterMask="0xfffffbff" castsShadows="true" receiveShadows="true" nonRenderable="true" materialIds="3" nodeId="4" />
        <TransformGroup name="seasons" nodeId="5">
          <TransformGroup name="winter" nodeId="6">
            <Shape name="icicles" shapeId="4" castsShadows="true" receiveShadows="true" materialIds="4" clipDistance="75" nodeId="7" weatherRequiredMask="0x400" />
            <Shape name="snow" shapeId="5" castsShadows="true" receiveShadows="true" materialIds="5" clipDistance="150" nodeId="8" />
          </TransformGroup>
          <TransformGroup name="autumn" nodeId="9">
            <Shape name="autumnLeafsDecal" shapeId="6" castsShadows="false" receiveShadows="true" decalLayer="1" materialIds="6" clipDistance="75" nodeId="10" weatherRequiredMask="0x200" />
          </TransformGroup>
        </TransformGroup>
      </Shape>
      <Shape name="LOD1" shapeId="7" castsShadows="true" receiveShadows="true" materialIds="1" clipDistance="600" nodeId="11" />
    </TransformGroup>
  </Scene>

  <UserAttributes>
  </UserAttributes>
</i3D>