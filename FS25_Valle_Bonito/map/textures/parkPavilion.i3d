<?xml version='1.0' encoding='utf-8'?>
<i3D xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="parkPavilion" version="1.6" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">

  <Files>
