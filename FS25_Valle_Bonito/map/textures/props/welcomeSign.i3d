<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="welcomeSign" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">

  <Files>
    <File fileId="4" filename="$data/shaders/placeableShader.xml" />
    <File fileId="6" filename="$data/shared/default_normal.png" />
    <File fileId="7" filename="welcomeSignDecal_diffuse.png" />
    <File fileId="1" filename="welcomeSign_diffuse.png" />
    <File fileId="2" filename="welcomeSign_normal.png" />
    <File fileId="3" filename="welcomeSign_specular.png" />
    <File fileId="5" filename="../terrain/forestDeepPineGreen01_diffuse.png" />
  </Files>

  <Materials>
    <Material name="lambert1" materialId="1" diffuseColor="0.5 0.5 0.5 1">
    </Material>
    <Material name="welcomeSign_mat" materialId="2" customShaderId="4">
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
    <Material name="forestDeepPineGreen01_mat" materialId="3" specularColor="0 0 0" customShaderId="4" customShaderVariation="alphaMap">
      <Texture fileId="5"/>
      <Normalmap fileId="6"/>
    </Material>
    <Material name="welcomeSignDecal_mat" materialId="4" specularColor="0 0 0">
      <Texture fileId="7"/>
      <Normalmap fileId="6"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="welcomeSign.i3d.shapes">
  </Shapes>

  <Scene>
    <Shape name="welcomeSign" lockedgroup="true" shapeId="1" static="true" density="0" collisionFilterGroup="0x3e" collisionFilterMask="0xfffffbff" castsShadows="true" receiveShadows="true" nonRenderable="true" materialIds="1" nodeId="1">
      <Shape name="visual" shapeId="2" castsShadows="true" receiveShadows="true" materialIds="2" clipDistance="250" nodeId="2"/>
      <Shape name="soil" shapeId="3" castsShadows="true" receiveShadows="true" materialIds="3" clipDistance="120" nodeId="3"/>
      <Shape name="decal" shapeId="4" castsShadows="false" receiveShadows="true" decalLayer="1" materialIds="4" clipDistance="150" nodeId="4"/>
    </Shape>
  </Scene>

  <UserAttributes>
  </UserAttributes>
</i3D>
