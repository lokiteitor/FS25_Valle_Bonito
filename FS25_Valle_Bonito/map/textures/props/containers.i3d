<?xml version='1.0' encoding='utf-8'?>
<i3D xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="containers" version="1.6" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">

  <Files>
    <File fileId="4" filename="$data/maps/mapEU/textures/props/containersDecal_diffuse.png" />
    <File fileId="1" filename="$data/maps/mapEU/textures/props/containers_diffuse.png" />
    <File fileId="2" filename="$data/maps/mapEU/textures/props/containers_normal.png" />
    <File fileId="3" filename="$data/maps/mapEU/textures/props/containers_specular.png" />
  </Files>

  <Materials>
    <Material name="lambert1" materialId="1" diffuseColor="0.5 0.5 0.5 1">
    </Material>
    <Material name="containers_mat" materialId="2">
      <Texture fileId="1" />
      <Normalmap fileId="2" />
      <Glossmap fileId="3" />
    </Material>
    <Material name="containersDecal_mat" materialId="3" specularColor="0 0 0">
      <Texture fileId="4" />
    </Material>
  </Materials>


  <Shapes externalShapesFile="containers.i3d.shapes">
  </Shapes>

  <Scene>
    <Shape name="container01" shapeId="1" static="true" density="0" collisionFilterGroup="0x3e" collisionFilterMask="0xfffffbff" castsShadows="true" receiveShadows="true" nonRenderable="true" materialIds="1" nodeId="1">
      <Shape name="vis" shapeId="2" castsShadows="true" receiveShadows="true" materialIds="2" clipDistance="300" nodeId="2" />
      <Shape name="decal" shapeId="3" castsShadows="false" receiveShadows="true" decalLayer="1" materialIds="3" clipDistance="80" nodeId="3" />
    </Shape>
    <Shape name="container02" shapeId="4" static="true" density="0" collisionFilterGroup="0x3e" collisionFilterMask="0xfffffbff" castsShadows="true" receiveShadows="true" nonRenderable="true" materialIds="1" nodeId="4">
      <Shape name="vis" shapeId="5" castsShadows="true" receiveShadows="true" materialIds="2" clipDistance="300" nodeId="5" />
      <Shape name="decal" shapeId="6" castsShadows="false" receiveShadows="true" decalLayer="1" materialIds="3" clipDistance="80" nodeId="6" />
    </Shape>
  </Scene>

  <UserAttributes>
  </UserAttributes>
