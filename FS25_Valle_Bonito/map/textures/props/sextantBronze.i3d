<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="sextantBronze" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">

  <Files>
    <File fileId="2" filename="$data/shared/default_normal.png" />
    <File fileId="3" filename="$data/shared/window02_specular.png" />
    <File fileId="1" filename="$data/shared/window_diffuse.png" />
    <File fileId="4" filename="sextantBronze_diffuse.png" />
    <File fileId="5" filename="sextantBronze_normal.png" />
    <File fileId="6" filename="sextantBronze_specular.png" />
  </Files>

  <Materials>
    <Material name="window_mat" materialId="2" alphaBlending="true">
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
    <Material name="sextantBronze_mat" materialId="1">
      <Texture fileId="4"/>
      <Normalmap fileId="5"/>
      <Glossmap fileId="6"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="sextantBronze.i3d.shapes">
  </Shapes>

  <Scene>
    <Shape name="sextantBronze" shapeId="1" castsShadows="true" receiveShadows="true" materialIds="1" clipDistance="300" nodeId="1">
      <Shape name="glass" shapeId="2" castsShadows="true" receiveShadows="true" materialIds="2" clipDistance="30" nodeId="2"/>
    </Shape>
  </Scene>

  <UserAttributes>
  </UserAttributes>
</i3D>
