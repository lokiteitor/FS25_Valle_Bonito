<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="parkingMetter" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">

  <Files>
    <File fileId="2" filename="$data/shared/default_normal.png" />
    <File fileId="1" filename="$data/shared/window02_diffuse.png" />
    <File fileId="3" filename="$data/shared/window02_specular.png" />
    <File fileId="4" filename="electricityMetterBoxDecals_diffuse.png" />
    <File fileId="5" filename="parkingMetter_diffuse.png" />
    <File fileId="6" filename="parkingMetter_normal.png" />
    <File fileId="7" filename="parkingMetter_specular.png" />
  </Files>

  <Materials>
    <Material name="lambert1" materialId="1" diffuseColor="0.5 0.5 0.5 1">
    </Material>
    <Material name="window02_mat" materialId="4" alphaBlending="true">
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
    <Material name="electricityMetterBoxDecals_mat" materialId="3" specularColor="0 0 0">
      <Texture fileId="4"/>
      <Normalmap fileId="2"/>
    </Material>
    <Material name="parkingMetter_mat" materialId="2">
      <Texture fileId="5"/>
      <Normalmap fileId="6"/>
      <Glossmap fileId="7"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="parkingMetter.i3d.shapes">
  </Shapes>

  <Scene>
    <Shape name="parkingMetterCamera" shapeId="1" static="true" density="0" collisionFilterGroup="0x3e" collisionFilterMask="0xfffffbff" castsShadows="true" receiveShadows="true" nonRenderable="true" materialIds="1" nodeId="1">
      <Shape name="visual" shapeId="2" castsShadows="true" receiveShadows="true" materialIds="2" clipDistance="100" nodeId="2"/>
      <Shape name="decal" shapeId="3" castsShadows="false" receiveShadows="true" decalLayer="1" materialIds="3" clipDistance="30" nodeId="3"/>
      <Shape name="glass" shapeId="4" castsShadows="true" receiveShadows="true" materialIds="4" clipDistance="30" nodeId="4"/>
    </Shape>
    <Shape name="parkingMetter" translation="2 0 0" shapeId="5" static="true" density="0" collisionFilterGroup="0x3e" collisionFilterMask="0xfffffbff" castsShadows="true" receiveShadows="true" nonRenderable="true" materialIds="1" nodeId="5">
      <Shape name="visual" shapeId="6" castsShadows="true" receiveShadows="true" materialIds="2" clipDistance="100" nodeId="6"/>
      <Shape name="decal" shapeId="7" castsShadows="false" receiveShadows="true" decalLayer="1" materialIds="3" clipDistance="30" nodeId="7"/>
      <Shape name="glass" shapeId="8" castsShadows="true" receiveShadows="true" materialIds="4" clipDistance="30" nodeId="8"/>
    </Shape>
  </Scene>

  <UserAttributes>
  </UserAttributes>
</i3D>
