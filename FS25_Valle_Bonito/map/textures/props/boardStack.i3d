      <Glossmap fileId="3"/>
    </Material>
    <Material name="boardStackSet_02_mat" materialId="3">
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="boardStack.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="boardStack" lodDistance="0 17" collision="false" density="0" nodeId="1">
      <Shape name="LOD0" shapeId="1" castsShadows="true" receiveShadows="true" materialIds="1" nodeId="2"/>
      <Shape name="LOD1" shapeId="2" castsShadows="true" receiveShadows="true" materialIds="1" clipDistance="300" nodeId="3"/>
      <Shape name="col" shapeId="3" static="true" collisionFilterGroup="0x3e" collisionFilterMask="0xfffffbff" castsShadows="true" receiveShadows="true" nonRenderable="true" materialIds="2" nodeId="4"/>
