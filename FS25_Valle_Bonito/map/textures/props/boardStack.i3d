    <TransformGroup name="boardStackNoSnow" lodDistance="0 17" collision="false" density="0" nodeId="5">
      <Shape name="LOD0" shapeId="4" castsShadows="true" receiveShadows="true" materialIds="3" nodeId="6"/>
      <Shape name="LOD1" shapeId="5" castsShadows="true" receiveShadows="true" materialIds="3" clipDistance="300" nodeId="7"/>
      <Shape name="col" shapeId="6" static="true" collisionFilterGroup="0x3e" collisionFilterMask="0xfffffbff" castsShadows="true" receiveShadows="true" nonRenderable="true" materialIds="2" nodeId="8"/>
