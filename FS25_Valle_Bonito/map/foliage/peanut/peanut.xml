<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<foliageType xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../shared/xml/schema/foliageType.xsd">
    <fruitType name="peanut" shownOnMap="true" useForFieldMissions="true">
        <mapColors default="0.7412 0.6039 0.3882 1" colorBlind="0.4863 0.3569 0.2078 1"/>
        <harvest litersPerSqm="0.9" cutHeight="0.15" chopperType="CHOPPER_STRAW"/>
        <growth resetsSpray="true" growthRequiresLime="true"/>
        <soil lowDensityRequired="true" increasesDensity="true" consumesLime="true" startSprayLevel="0"/>
        <seeding directionSnapAngle="0" needsRolling="false" litersPerSqm="0.001" isAvailable="true"/>
        <cultivation isAllowed="true"/>
        <mulcher chopperType="CHOPPER_STRAW"/>
    </fruitType>

    <!-- peanut

    5 6 7 8

    1 0 0 0 - 1 - invisible
    0 1 0 0 - 2 - green small
    1 1 0 0 - 3 - green middle
    0 0 1 0 - 4 - green big
    1 0 1 0 - 5 - harvest ready
    0 1 1 0 - 6 - dead
    1 1 1 0 - 7 - harvested (extructed)
    0 0 0 1 - 8 - cut haulm (not extructed)

    numBlocksPerUnit="1.333" == 1/1.333 ~ 0.75 meters between plants

    -->
    <foliageLayer densityMapChannelOffset="0" numDensityMapChannels="4" plantSeparation="1.0 0.6" plantOffset="0 0" plantLayoutRotation="true" shapeSource="peanut.i3d">
        <foliageStateDefaults distanceMapLayer="1" width="1" height="1" widthVariance="0.05" heightVariance="0.25" horizontalPositionVariance="0.1"/>
        <!-- default LOD distances etc -->
        <foliageLodDefaults lod="0" viewDistance="60" blendOutDistance="4" texCoords="0 0 1 1"/>
        <foliageLodDefaults lod="1" viewDistance="80" blendOutDistance="2" texCoords="0 0 1 1"/>
        <!-- 1 0 0 0 - invisible -->
        <foliageState name="invisible" isGrowing="true" allowsHoeing="true"/>
        <foliageState name="greenSmall" width="2" height="2" distanceMap="distance/foliage_parsnip_distance2_diffuse.png" isGrowing="true" allowsHoeing="true">
            <foliageShape>
                <foliageLod blockShape="0>0|0"/>
                <foliageLod blockShape="1>0|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|1"/>
                <foliageLod blockShape="1>0|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|2"/>
                <foliageLod blockShape="1>0|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|3"/>
                <foliageLod blockShape="1>0|0"/>
            </foliageShape>
        </foliageState>
        <foliageState name="greenMiddle" width="2" height="2" widthVariance="0.05" heightVariance="0.25" horizontalPositionVariance="0.25" distanceMap="distance/foliage_parsnip_distance3_diffuse.png" isGrowing="true" allowsHoeing="true">
            <foliageShape>
                <foliageLod blockShape="0>1|0"/>
                <foliageLod blockShape="1>1|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>1|1"/>
                <foliageLod blockShape="1>1|1"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>1|2"/>
                <foliageLod blockShape="1>1|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>1|3"/>
                <foliageLod blockShape="1>1|1"/>
            </foliageShape>
        </foliageState>
        <foliageState name="greenBig" width="2" height="2" widthVariance="0.05" heightVariance="0.25" horizontalPositionVariance="0.25" distanceMap="distance/foliage_parsnip_distance4_diffuse.png" isGrowing="true" isDestructibleByDisaster="true" allowsHoeing="true">
            <foliageShape>
                <foliageLod blockShape="0>2|0"/>
                <foliageLod blockShape="1>2|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>2|1"/>
                <foliageLod blockShape="1>2|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>2|2"/>
                <foliageLod blockShape="1>2|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>2|3"/>
                <foliageLod blockShape="1>2|0"/>
            </foliageShape>
        </foliageState>
        <foliageState name="harvestReady" width="2" height="2" widthVariance="0.05" heightVariance="0.25" horizontalPositionVariance="0.25" distanceMap="distance/foliage_parsnip_distance5_diffuse.png" isGrowing="true" isHarvestReady="true" isDestructibleByDisaster="true" isDestructedByWheel="true" groundType="HARVEST_READY_OTHER">
            <foliageShape>
                <foliageLod blockShape="0>3|0"/>
                <foliageLod blockShape="1>3|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>3|1"/>
                <foliageLod blockShape="1>3|1"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>3|2"/>
                <foliageLod blockShape="1>3|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>3|3"/>
                <foliageLod blockShape="1>3|1"/>
            </foliageShape>
        </foliageState>
        <foliageState name="dead" width="1.3" height="1.3" distanceMap="distance/foliage_parsnip_distance6_diffuse.png" isWithered="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0>4|0"/>
                <foliageLod blockShape="1>4|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>4|1"/>
                <foliageLod blockShape="1>4|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>4|2"/>
                <foliageLod blockShape="1>4|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>4|3"/>
                <foliageLod blockShape="1>4|0"/>
            </foliageShape>            
        </foliageState>
        <foliageState name="harvested" isCut="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0>5|0" />
                <!-- <foliageLod blockShape="0>1|5" /> -->
                <!-- <foliageLod blockShape="0>1|5" /> -->
            </foliageShape>
        </foliageState>
    </foliageLayer>

    <growth>
        <seasonal initialState="greenBig">
            <period name="EARLY_SPRING"/>
            <period name="MID_SPRING" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenBig" />
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="LATE_SPRING" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenBig" />
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="EARLY_SUMMER" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenBig" />
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="MID_SUMMER" >
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenBig" />
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="LATE_SUMMER">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenBig" />
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="EARLY_AUTUMN">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenBig" />
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="MID_AUTUMN">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenBig" />
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="LATE_AUTUMN">
                <update startState="harvestReady" endState="dead" />
            </period>
            <period name="EARLY_WINTER">
                <update startState="harvestReady" endState="dead" />
            </period>
            <period name="MID_WINTER"/>
            <period name="LATE_WINTER"/>
        </seasonal>
    </growth>
</foliageType>