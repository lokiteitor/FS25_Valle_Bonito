<?xml version="1.0" encoding="utf-8"?>
<foliageType xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../shared/xml/schema/foliageType.xsd">
    <fruitType name="napier" shownOnMap="true" useForFieldMissions="true">
        <mapColors default="0.5069 0.3231 0.0262 1" colorBlind="0.3968 0.3712 0.2159 1" />
        <harvest litersPerSqm="0.92" cutHeight="0.20" chopperType="CHOPPER_MAIZE" forageCutHeight="0.15" >
            <transition src="harvestReadyGreen"  target="harvestedCut" />
            <transition src="harvestReadyGreen2" target="harvestedCut" />
            <transition src="harvestReady3"      target="harvestedCut" />
        </harvest>
        <growth resetsSpray="true" growthRequiresLime="true"/>
        <soil lowDensityRequired="true" increasesDensity="true" consumesLime="true" startSprayLevel="1"/>
        <seeding directionSnapAngle="0" litersPerSqm="0.0053" isAvailable="true" defaultSowingGroundType="PLANTED"/>
        <cultivation isAllowed="true"/>
        <mulcher chopperType="CHOPPER_MAIZE"/>
    </fruitType>
    <!-- napier 
    
    5 6 7 8 
    
    1 0 0 0 - invisible
    0 1 0 0 - green small
    1 1 0 0 - green middle
    0 0 1 0 - green big
    1 0 1 0 - harvest ready
    0 1 1 0 - harvest ready
    1 1 1 0 - harvest ready
    0 0 0 1 - dead
    1 0 0 1 - harvested (cut)
    
    -->
    <foliageLayer cellSize="8" objectMask="16711935" decalLayer="0" densityMapChannelOffset="0" numDensityMapChannels="4" numBlocksPerUnit="1.3" shapeSource="napier.i3d">
        <foliageStateDefaults distanceMapLayer="1" widthVariance="0" heightVariance="0" horizontalPositionVariance="0" />
        <!-- default LOD distances etc -->
        <foliageLodDefaults lod="0" viewDistance="100" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1" />
        <foliageLodDefaults lod="1" viewDistance="120" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1" />
        <!-- 1 0 0 0 - invisible -->
        <foliageState name="invisible" />
        <!-- 0 1 0 0 - green small -->
        <foliageState name="greenSmall" distanceMap="distance/foliage_napier_distance2_diffuse.png" width="0.875" height="0.875" isGrowing="true" allowsWeeding="true" allowsHoeing="true">
            <foliageShape>
                <foliageLod blockShape="0>0" />
                <foliageLod blockShape="1>0" />
            </foliageShape>
        </foliageState>
        <!-- 1 1 0 0 - green middle -->
        <foliageState name="greenMiddle" distanceMap="distance/foliage_napier_distance3_diffuse.png" width="1.5" height="1.5" isGrowing="true" allowsHoeing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0>1" />
                <foliageLod blockShape="1>1" />
            </foliageShape>
        </foliageState>
        <!-- 0 0 1 0 - green big -->
        <foliageState name="greenBig" distanceMap="distance/foliage_napier_distance4_diffuse.png" width="2.9" height="2.9" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0>2" />
                <foliageLod blockShape="1>2" />
            </foliageShape>
        </foliageState>
        <!-- 1 0 1 0 - harvest ready -->
        <foliageState name="harvestReadyGreen" distanceMap="distance/foliage_napier_distance5_diffuse.png" width="2.9" height="2.9" isGrowing="true" isForageReady="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" groundType="HARVEST_READY_OTHER">
            <foliageShape>
                <foliageLod blockShape="0>3" />
                <foliageLod blockShape="1>3" />
            </foliageShape>
        </foliageState>
        <!-- 0 1 1 0 - harvest ready -->
        <foliageState name="harvestReadyGreen2" distanceMap="distance/foliage_napier_distance5_diffuse.png" width="2.9" height="2.9" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0>3" />
                <foliageLod blockShape="1>3" />
            </foliageShape>
        </foliageState>
        <!-- 1 1 1 0 - harvest ready -->
        <foliageState name="harvestReady3" distanceMap="distance/foliage_napier_distance5_diffuse.png" width="2.9" height="2.9" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" isHarvestReady="true">
            <foliageShape>
                <foliageLod blockShape="0>3" />
                <foliageLod blockShape="1>3" />
            </foliageShape>
        </foliageState>
        <!-- 0 0 0 1 - dead -->
        <foliageState name="dead" distanceMap="distance/foliage_napier_distance6_diffuse.png" width="2" height="2.2" isWithered="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0>4" />
                <foliageLod blockShape="1>4" />
            </foliageShape>
        </foliageState>
        <!-- 1 0 0 1 - harvested (cut) -->
        <foliageState name="harvestedcut" distanceMap="distance/foliage_napier_distance7_diffuse.png" width="2" height="2.2" isCut="true" isDestructedByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0>5" />
                <foliageLod blockShape="1>5" />
            </foliageShape>
        </foliageState>
        <!--  -->
    </foliageLayer>
	
	<growth>
        <seasonal initialState="greenBig"> <!-- not available in spring and thus no initial state -->
            <period name="EARLY_SPRING" />
            <period name="MID_SPRING" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
            </period>
            <period name="LATE_SPRING" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenMiddle" />
            </period>
            <period name="EARLY_SUMMER">
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenBig" />
            </period>
            <period name="MID_SUMMER">
                <update startState="greenMiddle" endState="greenBig" />
                <update startState="greenBig" endState="harvestReadyGreen" />
            </period>
            <period name="LATE_SUMMER">
                <update startState="greenBig" endState="harvestReadyGreen" />
                <update startState="harvestReadyGreen" endState="harvestReadyGreen2" />
            </period>
            <period name="EARLY_AUTUMN">
                <update startState="harvestReadyGreen" endState="harvestReadyGreen2" />
                <update startState="harvestReadyGreen2" endState="harvestReady3" />
            </period>
            <period name="MID_AUTUMN">
                <update startState="harvestReadyGreen2" endState="harvestReady3" />
            </period>
            <period name="LATE_AUTUMN">
                <update startState="harvestReady3" endState="dead" />
            </period>
            <period name="EARLY_WINTER" />
            <period name="MID_WINTER" />
            <period name="LATE_WINTER" />
        </seasonal>
    </growth>
</foliageType>
